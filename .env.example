# Copy to .env and fill in. Never commit the real .env file.

NODE_ENV=development

# Database
DATABASE_URL="postgresql://user@localhost:5432/planmyownhouse_dev?schema=public"

# Auth.js — generate AUTH_SECRET with `npx auth secret`
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email — "console" logs verification/reset links to the server console for local dev.
# Switch to "resend" and set RESEND_API_KEY in production.
EMAIL_PROVIDER="console"
EMAIL_FROM="planMyOwnHouse <no-reply@planmyownhouse.local>"
RESEND_API_KEY=""

# Rate limiting — "memory" is per-process, local-dev only. Switch to "upstash" in prod.
RATE_LIMIT_PROVIDER="memory"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Object storage — inert placeholders, not read until Phase 4.
STORAGE_PROVIDER="minio"
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
