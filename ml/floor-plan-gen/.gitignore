# Downloaded dataset and derived artifacts — re-run data/download.py to repopulate.
# Anchored to this directory only (leading /) — an unanchored "data/" would also
# match src/floorplan_gen/data/, the actual Python subpackage, and silently exclude
# it from git (which is exactly what happened here once, the hard way).
/data/

# Trained weights — large, and not reproducible-by-diff; keep them in Drive, not git.
/checkpoints/
*.pt
*.pth

# Python
__pycache__/
*.pyc
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# Colab sometimes materializes this locally when Drive is mounted
drive/
